{
  "name": "mail-scanner",
  "version": "1.0.0",
  "description": "Background mail scanner that starts with your PC and checks your inbox over IMAP.",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "imapflow": "2.9.1",
    "mailparser": "3.7.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.local.mailscanner",
    "productName": "Mail Scanner",
    "protocols": [
      {
        "name": "Mail Scanner",
        "schemes": [
          "mail-scanner"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
